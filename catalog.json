{
  "name": "TMA Official Plugins",
  "plugins": [
    {
      "id": "tma.official.spotify",
      "name": "Spotify",
      "version": "0.2.0",
      "description": "Resolves artists to Spotify IDs with the Client Credentials flow: exchanges client id/secret for a token, then searches by artist name or ISRC (`/v1/search`) and persists only the ID. Requires the client ID and client secret of a Spotify app from the developer dashboard. Use \"Test connection\" to verify the credentials can obtain a token.",
      "author": "TMA",
      "homepage": "https://github.com/liuyincs/tma-plugins-official/tree/main/plugins/spotify",
      "abi": {
        "min": {
          "major": 1,
          "minor": 5
        },
        "max": {
          "major": 1,
          "minor": 5
        }
      },
      "permissions": [
        {
          "http": {
            "scheme": "https",
            "host": "accounts.spotify.com",
            "reason": "Spotify Client Credentials 换取 access token"
          }
        },
        {
          "http": {
            "scheme": "https",
            "host": "api.spotify.com",
            "reason": "Spotify 搜索接口（按名称或 ISRC 检索艺术家）"
          }
        }
      ],
      "download_url": "https://github.com/liuyincs/tma-plugins-official/releases/download/spotify-v0.2.0/spotify.tmap",
      "sha256": "86db14868f79bcb0370c48260b5eaf4aaa00c40a94fb498bdaf2590d824a239a",
      "public_key_url": "https://raw.githubusercontent.com/liuyincs/tma-plugins-official/spotify-v0.2.0/public-key.txt",
      "public_key_fingerprint": "sha256:aebbc3594c76ab3d22ee2baf806695671df1318df8c6f5a48b6257a42ec734a0"
    }
  ]
