{
  "id": "tma.official.lastfm",
  "name": "Last.fm",
  "version": "0.1.0",
  "abi": {
    "min": { "major": 1, "minor": 5 },
    "max": { "major": 1, "minor": 6 }
  },
  "extension_points": ["scrape_provider", "playlist_import", "scrobble_reporter"],
  "permissions": [
    {
      "http": {
        "scheme": "https",
        "host": "ws.audioscrobbler.com",
        "reason": "Last.fm 艺术家简介/图片接口"
      }
    },
    {
      "ai": {
        "reason": "用单轮 AI 从自由文本抽取曲目列表"
      }
    }
  ],
  "scrape": {
    "provider": "last_fm",
    "capabilities": ["external_ids", "bio", "image"],
    "requires_credentials": true,
    "library_types": ["music"]
  },
  "scrobble_reporter": {
    "events": ["scrobble", "now_playing"],
    "library_types": ["music"]
  },
  "description": "Last.fm 艺术家简介与图片（需 api_key）",
  "author": "TMA",
  "homepage": "https://www.last.fm",
  "config_schema": {
    "type": "object",
    "properties": {
      "language": {
        "type": "string",
        "enum": ["zh", "en", "ja"],
        "title": "$config.language.title",
        "description": "$config.language.description"
      },
      "autocorrect": {
        "type": "boolean",
        "title": "$config.autocorrect.title"
      },
      "requests_per_second": {
        "type": "number"
      },
      "api_key": {
        "type": "string",
        "title": "$config.api_key.title"
      },
      "http": {
        "type": "object",
        "properties": {
          "timeout_seconds": {
            "type": "number",
            "title": "$config.http.timeout_seconds.title"
          }
        }
      }
    },
    "required": ["api_key"]
  },
  "config_secrets": ["api_key"],
  "playlist_import": {
    "methods": [
      {
        "id": "from_text",
        "label": "$playlist_import.from_text.label",
        "input_schema": {
          "type": "object",
          "required": ["text"],
          "properties": {
            "text": {
              "type": "string",
              "title": "$playlist_import.from_text.text.title",
              "x-ui": "textarea"
            }
          }
        },
        "requires_ai": true
      }
    ]
  },
  "actions": [
    {
      "id": "refresh_bio_cache",
      "label": "$actions.refresh_bio_cache.label"
    }
  ],
  "i18n": {
    "en": {
      "name": "Last.fm",
      "description": "Last.fm artist biography and images (requires api_key)",
      "config.language.title": "Response language",
      "config.language.description": "Language for biography text",
      "config.autocorrect.title": "Auto-correct misspelled artist names",
      "config.api_key.title": "Last.fm API key",
      "config.http.timeout_seconds.title": "HTTP timeout (seconds)",
      "actions.refresh_bio_cache.label": "Refresh cached biography",
      "playlist_import.from_text.label": "Import from pasted text",
      "playlist_import.from_text.text.title": "Track list text"
    },
    "zh": {
      "name": "Last.fm",
      "description": "Last.fm 艺术家简介与图片（需 api_key）",
      "config.language.title": "响应语言",
      "config.language.description": "简介文本语言",
      "config.autocorrect.title": "自动纠正拼写错误的艺术家名",
      "config.api_key.title": "Last.fm API key",
      "config.http.timeout_seconds.title": "HTTP 超时（秒）",
      "actions.refresh_bio_cache.label": "刷新缓存的简介",
      "playlist_import.from_text.label": "从粘贴文本导入",
      "playlist_import.from_text.text.title": "曲目列表文本"
    }
  }
}
